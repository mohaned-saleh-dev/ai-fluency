# OpenAI (primary)
OPENAI_API_KEY=sk-your-openai-key-here
# AIQ_OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE=https://api.openai.com/v1

# Google AI (Gemini — fallback when OpenAI key is missing)
# GOOGLE_API_KEY=your_key_here
# or
# GEMINI_API_KEY=
# AIQ_GEMINI_MODEL=gemini-2.5-flash
# AIQ_LLM_CLASSIFY=0
# AIQ_INTERVIEWER_REPAIR=0

# LLM: openai (default) -> gemini (fallback if OpenAI key missing) -> ollama (local fallback)
# or force gemini | openai | ollama
# AIQ_LLM_PROVIDER=openai
# OLLAMA_BASE=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2

# Long random string for /admin
AIQ_ADMIN_SECRET=ai-fluency-secret182736453
# Optional: multiple valid admin codes (comma/semicolon/newline separated)
# AIQ_ADMIN_SECRETS=alpha,beta,gamma

# --- Where data is stored (local dev) ---
# Put SQLite + orchestrator overrides under your home folder (outside the repo):
# AIQ_STORE_DATA_IN_HOME=1
# Free public URL + persistent DB on your Mac (needs cloudflared): ./scripts/run_local_persistent_tunnel.sh
# Single-process Flask for clean Ctrl+C: FLASK_DEBUG=0
# Or set an explicit directory:
# AIQ_LOCAL_DATA_DIR=/Users/you/Library/Application Support/AiQ
# Single-file override (optional; defaults to <INSTANCE_DIR>/aiq_csuite.db):
# AIQ_SQLITE_PATH=/path/to/aiq_csuite.db
# Postgres override (Supabase/Neon/etc). When set, app ignores SQLite:
# Render / long-running Flask — prefer Supabase **Direct connection** (not pooler):
# DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
# Optional: keep pooler in DATABASE_URL and set direct URI here (takes precedence):
# DATABASE_DIRECT_URL=postgresql://postgres:PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres?sslmode=require
# Pooler (serverless): copy exact host/port/user from Supabase → Connect; user must be postgres.YOUR_REF
# DATABASE_URL=postgresql://postgres.YOUR_REF:PASSWORD@aws-1-REGION.pooler.supabase.com:6543/postgres?sslmode=require
# Supabase: init_db enables RLS on AiQ tables (see sql/supabase_harden_aiq_tables.sql).
#
# Render free tier: ~/.aiq_csuite is still on ephemeral disk — use Postgres or paid disk for durability.

# Open sessions are auto-ended after this many hours (no new chat messages; scoring can still be requested).
# AIQ_SESSION_MAX_AGE_HOURS=24
